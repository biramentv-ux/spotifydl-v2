{
  "name": "spotify-hybrid-downloader-v2",
  "version": "2.0.0",
  "description": "Advanced Spotify downloader with hybrid engines, GraphQL, Neo4j, ML recommendations, and real-time features",
  "main": "dist/index.js",
  "bin": {
    "spotify-dl": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:native": "node-gyp rebuild",
    "install": "npm run build:native || echo 'Native build optional'",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "cli": "ts-node src/cli/index.ts",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "spotify",
    "downloader",
    "music",
    "graphql",
    "neo4j",
    "machine-learning",
    "websocket",
    "telegram-bot"
  ],
  "author": "SpotifyDL Team",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "axios": "^1.6.7",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dropbox": "^10.34.0",
    "express": "^4.18.2",
    "figlet": "^1.7.0",
    "googleapis": "^131.0.0",
    "graphql": "^16.8.1",
    "graphql-tag": "^2.12.6",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "neo4j-driver": "^5.17.0",
    "node-addon-api": "^8.9.1",
    "open": "^8.4.2",
    "ora": "^5.4.1",
    "semver": "^7.5.4",
    "telegraf": "^4.15.3",
    "winston": "^3.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/figlet": "^1.5.8",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.16",
    "@types/semver": "^7.5.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
